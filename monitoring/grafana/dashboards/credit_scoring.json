{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "📊 Data Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Raw Applications",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT COUNT(*)::bigint AS value FROM raw.applications;",
        "format": "table"
      }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "type": "stat",
      "title": "Payment History",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT COUNT(*)::bigint AS value FROM raw.payment_history;",
        "format": "table"
      }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "type": "stat",
      "title": "Features (total)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT COUNT(*)::bigint AS value FROM features.application_features;",
        "format": "table"
      }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "type": "stat",
      "title": "Predictions",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT COUNT(*)::bigint AS value FROM predictions.scoring_predictions;",
        "format": "table"
      }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "purple", "value": null }] } } }
    },
    {
      "type": "stat",
      "title": "Default Rate",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT ROUND(AVG(CASE WHEN is_default THEN 1.0 ELSE 0.0 END)::numeric, 4) AS value FROM raw.applications;",
        "format": "table"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2 } }
    },
    {
      "type": "stat",
      "title": "Drift Alerts",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT COUNT(*)::bigint AS value FROM monitoring.feature_drift WHERE is_drifted = true AND checked_at > now() - interval '7 days';",
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "📈 Data Trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Applications per Month",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT date_trunc('month', application_date)::timestamptz AS time, COUNT(*)::double precision AS applications FROM raw.applications GROUP BY 1 ORDER BY 1;",
        "format": "time_series"
      }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 30 } } }
    },
    {
      "type": "timeseries",
      "title": "Default Rate by Month",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT date_trunc('month', application_date)::timestamptz AS time, AVG(CASE WHEN is_default THEN 1.0 ELSE 0.0 END)::double precision AS default_rate FROM raw.applications GROUP BY 1 ORDER BY 1;",
        "format": "time_series"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 0.5 } }
    },
    {
      "type": "row",
      "title": "🤖 Prediction Distribution",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Mean PD Score (daily)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT date_trunc('day', predicted_at)::timestamptz AS time, AVG(pd_calibrated)::double precision AS mean_pd FROM predictions.scoring_predictions GROUP BY 1 ORDER BY 1;",
        "format": "time_series"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "type": "timeseries",
      "title": "Predictions by Model (daily)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('day', predicted_at)::timestamptz AS time, COUNT(*)::double precision AS with_history FROM predictions.scoring_predictions WHERE model_version LIKE '%with_history%' GROUP BY 1 ORDER BY 1;",
          "format": "time_series"
        },
        {
          "rawSql": "SELECT date_trunc('day', predicted_at)::timestamptz AS time, COUNT(*)::double precision AS cold_start FROM predictions.scoring_predictions WHERE model_version LIKE '%cold_start%' GROUP BY 1 ORDER BY 1;",
          "format": "time_series"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "type": "piechart",
      "title": "Risk Bucket Distribution",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT risk_bucket AS metric, COUNT(*)::bigint AS value FROM predictions.scoring_predictions GROUP BY 1 ORDER BY 1;",
        "format": "table"
      }],
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } }
    },
    {
      "type": "row",
      "title": "⚠️ Drift Monitoring",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Feature PSI Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT checked_at::timestamptz AS time, psi_value::double precision AS psi, feature_name FROM monitoring.feature_drift ORDER BY 1;",
        "format": "time_series"
      }],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" } },
        "overrides": [{
          "matcher": { "id": "byName", "options": "psi" },
          "properties": [{ "id": "thresholds", "value": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.10 }, { "color": "red", "value": 0.25 }] } }]
        }]
      }
    },
    {
      "type": "table",
      "title": "Latest Drift Results",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT feature_name, check_date, ROUND(psi_value::numeric, 4) AS psi, ROUND(ks_statistic::numeric, 4) AS ks, is_drifted FROM monitoring.feature_drift ORDER BY checked_at DESC LIMIT 30;",
        "format": "table"
      }],
      "options": { "showHeader": true }
    },
    {
      "type": "row",
      "title": "📋 Data Quality",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "Feature Summary Statistics",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "postgres", "uid": "postgres-credit-scoring" },
      "targets": [{
        "rawSql": "SELECT COUNT(*) AS total_rows, ROUND(AVG(loan_to_income)::numeric, 3) AS avg_lti, ROUND(AVG(credit_score_norm)::numeric, 3) AS avg_cs_norm, ROUND(AVG(interest_rate)::numeric, 2) AS avg_rate, ROUND(AVG(avg_days_overdue_90d)::numeric, 2) AS avg_overdue_90d, ROUND(AVG(payment_consistency_90d)::numeric, 3) AS avg_consistency FROM features.application_features;",
        "format": "table"
      }],
      "options": { "showHeader": true }
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["credit-scoring", "pd", "dual-model"],
  "templating": { "list": [] },
  "time": { "from": "now-5y", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Credit Scoring PD — Dual Model",
  "uid": "credit-scoring-pd-dual",
  "version": 3
}
